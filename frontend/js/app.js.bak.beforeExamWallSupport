  const isMain = window._adminIsMain;

  let h = '<div class="admin-menu-popover" style="top:' + Math.min(rect.bottom + 4, window.innerHeight - 320) + 'px;left:' + Math.min(rect.right - 240, window.innerWidth - 250) + 'px;">';
