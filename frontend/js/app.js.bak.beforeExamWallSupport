  if (batchVoucherBtn) batchVoucherBtn.addEventListener('click', () => showBatchVoucherModal());
  const resetVouchersBtn = document.getElementById('adminResetVouchersBtn');
  if (resetVouchersBtn) resetVouchersBtn.addEventListener('click', showResetVouchersModal);

  // Cert sub-tabs
  document.querySelectorAll('[data-cert-sub]').forEach(btn => {
    btn.addEventListener('click', () => {
      const sub = btn.getAttribute('data-cert-sub');
      document.querySelectorAll('[data-cert-sub]').forEach(b => b.classList.toggle('active', b === btn));
      document.querySelectorAll('[data-cert-pane]').forEach(p => {
        p.style.display = p.getAttribute('data-cert-pane') === sub ? 'block' : 'none';
      });
      if (sub === 'template') {
        setTimeout(renderAdminCertTemplateContent, 30);
      }
    });
  });

  // Analytics range pills
  document.querySelectorAll('[data-analytics-range]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-analytics-range]').forEach(b => b.classList.toggle('active', b === btn));
      const days = parseInt(btn.getAttribute('data-analytics-range'));
      drawAdminAnalyticsCharts(days);
    });
  });

  // Kick off chart draws + activity feed
  setTimeout(() => {
    drawAdminOverviewCharts();
    loadAdminActivityFeed();
    const initialTab = _adminState.activeTab;
    if (initialTab === 'analytics') drawAdminAnalyticsCharts(30);
  }, 80);
}

