  // Debug output area
  h += '<div id="adminLegalDebug" style="display:none;padding:10px 12px;background:#000;border:1px solid #333;border-radius:8px;font-family:monospace;font-size:11px;color:#0f0;margin-bottom:14px;max-height:180px;overflow-y:auto;white-space:pre-wrap;"></div>';

