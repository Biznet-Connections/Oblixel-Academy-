async function loadCourseRevenues() {
  try {
    const resp = await apiRequest('/admin/analytics/revenue-by-course');
    const map = new Map((resp.courses || []).map(c => [c.courseId, c]));
    document.querySelectorAll('[data-course-revenue]').forEach(el => {
      const id = el.getAttribute('data-course-revenue');
      const data = map.get(id);
      if (data) el.innerHTML = '<strong style="color:var(--a-text)">$' + formatMoney(data.revenue) + '</strong><div style="font-size:11px;color:var(--a-muted)">' + data.payments + ' payments</div>';
      else el.innerHTML = '$0<div style="font-size:11px;color:var(--a-muted)">0 payments</div>';
    });
  } catch (e) { console.error('Course revenues error:', e); }
}

function renderAdminVouchersTableContent() {
  const wrap = document.getElementById('adminVouchersTableWrap');
  if (!wrap) return;
  const vouchers = _adminState.vouchers;

  if (!vouchers.length) {
    wrap.innerHTML = '<p style="padding:24px;text-align:center;color:var(--a-muted);font-size:13px;">No vouchers yet.</p>';
    return;
  }

  let h = '<table class="admin-table-pro"><thead><tr>';
  h += '<th>Code</th><th>Discount</th><th>Course</th><th>Usage</th><th>Status</th><th>Expires</th><th style="text-align:right">Actions</th>';
  h += '</tr></thead><tbody>';

  for (const v of vouchers) {
    const disc = v.discountType === 'free' ? '🎁 FREE' : (v.discountValue + (v.discountType === 'percentage' ? '%' : ' USD'));
    const courseName = v.courseId === 'all' ? 'All Courses' : ((_adminState.courses.find(c => c.id === v.courseId) || {}).name || v.courseId);
    const used = v.usedCount || 0;
    const max = v.maxUses || 1;

    // Usage display — bar + count
    const pct = max > 0 ? Math.min(100, Math.round((used / max) * 100)) : 0;
    const barColor = used >= max ? 'var(--a-danger)' : used > 0 ? 'var(--a-warning)' : 'var(--a-success)';

    // Status badge
    let statusBadge = '';
    if (!v.active) statusBadge = '<span class="admin-pill warn">Inactive</span>';
    else if (used >= max) statusBadge = '<span class="admin-pill warn">USED</span>';
    else if (used > 0) statusBadge = '<span class="admin-pill warn">Partial</span>';
    else statusBadge = '<span class="admin-pill ok">Available</span>';

    // Expired?
    if (v.expiresAt && new Date(v.expiresAt) < new Date()) {
      statusBadge = '<span class="admin-pill warn">Expired</span>';
    }

    h += '<tr>';
    h += '<td data-label="Code"><span style="font-family:monospace;color:var(--a-accent-hi);font-weight:600;">' + escapeHtml(v.code) + '</span></td>';
    h += '<td data-label="Discount">' + disc + '</td>';
    h += '<td data-label="Course">' + escapeHtml(courseName) + '</td>';
    h += '<td data-label="Usage"><div style="display:flex;align-items:center;gap:8px;min-width:100px;"><div style="flex:1;height:6px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden;"><div style="height:100%;width:' + pct + '%;background:' + barColor + ';transition:width 0.3s;"></div></div><span style="font-size:12px;color:var(--a-text);font-weight:600;white-space:nowrap;">' + used + '/' + max + '</span></div></td>';
    h += '<td data-label="Status">' + statusBadge + '</td>';
    h += '<td data-label="Expires">' + (v.expiresAt ? new Date(v.expiresAt).toLocaleDateString() : 'Never') + '</td>';
    h += '<td data-label="Actions" style="text-align:right;"><button class="admin-row-menu-btn" data-voucher-menu="' + v._id + '"><i class="fa-solid fa-ellipsis"></i></button></td>';
    h += '</tr>';
  }
  h += '</tbody></table>';
  wrap.innerHTML = h;

  wrap.querySelectorAll('[data-voucher-menu]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const vId = btn.getAttribute('data-voucher-menu');
      openAdminVoucherMenu(btn, vId);
    });
  });
}

