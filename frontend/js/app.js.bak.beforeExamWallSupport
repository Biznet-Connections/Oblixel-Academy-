  h += '<div class="admin-menu-divider"></div>';
  h += '<button class="admin-menu-item danger" data-action="delete-voucher"><i class="fa-solid fa-trash"></i>Delete voucher</button>';
  h += '</div>';
  document.body.insertAdjacentHTML('beforeend', h);
  const menu = document.querySelector('.admin-menu-popover:last-child');
  menu.addEventListener('click', (e) => {
    const item = e.target.closest('.admin-menu-item');
    if (!item) return;
    const action = item.getAttribute('data-action');
    if (action === 'copy-code') {
      if (window.copyToClipboard) copyToClipboard(voucher.code);
      else { navigator.clipboard.writeText(voucher.code); showToast('Copied: ' + voucher.code, 'success'); }
    } else if (action === 'view-usage') {
      showAdminVoucherUsageModal(voucher);
    } else if (action === 'delete-voucher') {
      if (window.deleteVoucherItem) deleteVoucherItem(voucherId);
    }
    closeAllAdminMenus();
  });
}

