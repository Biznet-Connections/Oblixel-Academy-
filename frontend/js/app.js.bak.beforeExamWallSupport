}
function _blockDrag(e) { e.preventDefault(); return false; }
function _blockKeys(e) {
  const k = (e.key || '').toLowerCase();
  if ((e.ctrlKey || e.metaKey) && ['c','x','a','s','p','u'].includes(k)) {
