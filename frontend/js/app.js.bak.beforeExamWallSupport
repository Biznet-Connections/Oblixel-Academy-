  }
  window.openForgotPassword();

  // Pre-fill email in the modal
  setTimeout(() => {
    const emailInput = document.getElementById('fpEmailInput');
    if (emailInput) emailInput.value = currentUser.email || '';

    // Auto-send the reset code (skips manual "Send Code" step)
    if (typeof window.fpSendCode === 'function') {
      try {
        window.fpSendCode();
        showToast('Reset code sent to ' + currentUser.email, 'success');
      } catch (e) {
        console.warn('[openChangePasswordFlow] fpSendCode failed:', e);
      }
