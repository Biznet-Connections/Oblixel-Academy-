// ==================== COURSE DEEPLINK HANDLER (v15) ====================
// Detects /course/:slug on load. Shows landing, scrolls to card, highlights.
(function() {
  function getSlugFromPath() {
    const m = window.location.pathname.match(/^\/course\/([a-z0-9\-]+)/i);
    return m ? m[1].toLowerCase() : null;
  }

  async function handleDeeplink() {
    const slug = getSlugFromPath();
    if (!slug) return;

    console.log('[Deeplink] course slug:', slug);

    // Wait until app is ready
    if (typeof window.renderLandingPage !== 'function') {
      setTimeout(handleDeeplink, 300);
      return;
    }

    try {
      // Fetch course
      const r = await fetch('/api/courses/by-slug/' + slug);
      if (!r.ok) {
        console.warn('[Deeplink] course not found, rendering landing');
        renderLandingPage();
        return;
      }
      const course = await r.json();
      console.log('[Deeplink] found course:', course.name);

      // Save for the share flow / enroll modal
      window.__deeplinkCourse = course;

      // Render landing
      renderLandingPage();

      // After render, scroll + highlight + show banner
      setTimeout(() => {
        showDeeplinkBanner(course);
        robustScroll(course.courseId);
      }, 600);
    } catch (e) {
      console.error('[Deeplink] error:', e);
      if (typeof renderLandingPage === 'function') renderLandingPage();
    }
  }

  function showDeeplinkBanner(course) {
    if (document.getElementById('deeplinkBanner')) return;

    const price = course.price || course.examPrice || 0;
    const banner = document.createElement('div');
    banner.id = 'deeplinkBanner';
    banner.style.cssText = `
      position: fixed; top: 76px; left: 50%; transform: translateX(-50%);
      z-index: 200; background: linear-gradient(135deg, #8b5cf6, #6d28d9);
      color: #fff; padding: 14px 18px; border-radius: 14px;
      box-shadow: 0 20px 60px rgba(139,92,246,0.5), 0 0 0 1px rgba(255,255,255,0.1);
      max-width: 92vw; width: 480px; display: flex; align-items: center; gap: 14px;
      font-size: 13.5px; font-weight: 600; animation: dlIn 0.5s ease;
    `;
    banner.innerHTML = `
      <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="fa-solid fa-share-nodes" style="font-size:16px;"></i>
      </div>
      <div style="flex:1;min-width:0;">
        <div style="opacity:.8;font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;margin-bottom:2px;font-weight:700;">🎯 Someone shared this with you</div>
        <div style="font-size:14px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${course.name}</div>
        <div style="font-size:11.5px;opacity:.85;margin-top:1px;">From $${price} · Tap to jump</div>
      </div>
      <button id="deeplinkJump" style="background:rgba(255,255,255,0.22);border:none;color:#fff;padding:8px 14px;border-radius:8px;cursor:pointer;font-size:12px;font-weight:700;display:flex;align-items:center;gap:6px;font-family:inherit;"><i class="fa-solid fa-arrow-down"></i>Jump</button>
      <button id="deeplinkClose" style="background:transparent;border:none;color:#fff;width:26px;height:26px;cursor:pointer;font-size:16px;opacity:.7;">✕</button>
    `;
    document.body.appendChild(banner);

    const style = document.createElement('style');
    style.textContent = '@keyframes dlIn{from{opacity:0;transform:translateX(-50%) translateY(-10px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}';
    document.head.appendChild(style);

    // Make the whole banner clickable (except close button)
    banner.style.cursor = 'pointer';
    banner.onclick = (e) => {
      if (e.target.id === 'deeplinkClose' || e.target.closest('#deeplinkClose')) return;
      scrollToAndHighlight(course.courseId);
    };

    document.getElementById('deeplinkClose').onclick = (e) => {
      e.stopPropagation();
      banner.style.transition = 'opacity .3s, transform .3s';
      banner.style.opacity = '0';
      banner.style.transform = 'translateX(-50%) translateY(-20px)';
      setTimeout(() => banner.remove(), 400);
    };

    // Auto-dismiss after 25s
    setTimeout(() => { if (document.body.contains(banner)) banner.remove(); }, 25000);
  }

  // Robust scroll - retries up to 5s if card not rendered yet
  function robustScroll(courseId, attempt) {
    attempt = attempt || 0;
    var card = document.querySelector('[data-course-id="' + courseId + '"]');
    if (!card) {
      var btn = document.querySelector('button[onclick*="handleEnrollClick(' + String.fromCharCode(39) + courseId + String.fromCharCode(39) + ')"]');
      if (btn) card = btn.closest('div[class*="rounded"], [data-aos]');
    }
    if (card) {
      scrollToAndHighlight(courseId);
      return;
    }
    if (attempt < 15) {
      setTimeout(function() { robustScroll(courseId, attempt + 1); }, 300);
    } else {
      console.warn('[Deeplink] Gave up scrolling to', courseId);
    }
  }
  function scrollToAndHighlight(courseId) {
    // Try precise match first
    let card = document.querySelector('[data-course-id="' + courseId + '"]');

    // Fallback 1: match by button onclick
    if (!card) {
      const btn = document.querySelector('button[onclick*="handleEnrollClick(' + "'" + courseId + "'" + ')"]');
      if (btn) {
        card = btn.closest('.glass, [data-aos], div[class*="rounded"]');
      }
    }

    // Fallback 2: try case variants
    if (!card) {
      const variants = [courseId, courseId.toLowerCase(), courseId.toUpperCase()];
      for (const v of variants) {
        card = document.querySelector('[data-course-id="' + v + '"]');
        if (card) break;
      }
    }

    if (!card) {
      // Last resort: scroll to certifications section
      const section = document.getElementById('certifications');
      if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      console.warn('[Deeplink] Could not find card for', courseId);
      return;
    }

    // Scroll to card
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });

    // Add glow class (defined in CSS)
    card.classList.add('deeplink-highlight');

    // Auto-remove after 6 seconds
    setTimeout(() => {
      card.classList.remove('deeplink-highlight');
    }, 6000);
  }

  // Run after DOM ready + a small delay for app.js to init
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => setTimeout(handleDeeplink, 200));
  } else {
    setTimeout(handleDeeplink, 200);
  }

  window.__handleDeeplink = handleDeeplink;
})();

// ==================== COURSE SHARE FLOW (v15) ====================
window.shareCourse = async function(courseId) {
  try {
    // Ensure course is loaded
    if (!coursesData || coursesData.length === 0) {
      if (typeof loadCourses === 'function') await loadCourses();
    }
    const course = (coursesData || []).find(c => c.id === courseId || c.courseId === courseId);
    if (!course) { showToast('Course not found', 'error'); return; }

    // Fetch slug from server (or use cached if present)
    let slug = course.slug;
    if (!slug) {
      try {
        const r = await fetch('/api/courses/by-slug/' + courseId);
        if (r.ok) { const full = await r.json(); slug = full.slug; }
      } catch (e) {}
    }
    if (!slug) slug = slugify(course.name);

    const url = window.location.origin + '/course/' + slug;

    showShareModal(course, url);
  } catch (e) {
    console.error('[Share] error:', e);
    showToast('Could not share this course', 'error');
  }
};

function slugify(str) {
  return String(str || '')
    .toLowerCase()
    .replace(/\(([^)]+)\)/g, '$1')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .replace(/-+/g, '-');
}

