// When buyer lands here with ?retry=1, auto-open the enroll modal for the
// saved pending course, and show a retry banner.
(function() {
  try {
    var params = new URLSearchParams(window.location.search);
    if (params.get('retry') !== '1') return;

    var pendingRaw = sessionStorage.getItem('linkwa_pending_course');
    if (!pendingRaw) return;
    var pending = JSON.parse(pendingRaw);
    if (!pending || !pending.courseId) return;

    // Show a banner
    function showBanner() {
      if (document.getElementById('linkwaRetryBanner')) return;
      var b = document.createElement('div');
      b.id = 'linkwaRetryBanner';
      b.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);z-index:9000;background:rgba(251,191,36,0.15);border:1px solid rgba(251,191,36,0.5);color:#fbbf24;padding:12px 20px;border-radius:14px;font-size:14px;font-weight:600;backdrop-filter:blur(10px);max-width:92vw;text-align:center;';
      b.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-2"></i> Your previous payment didn\'t complete. Try again below.';
      document.body.appendChild(b);
      setTimeout(function() {
        b.style.transition = 'opacity 0.5s';
        b.style.opacity = '0';
        setTimeout(function() { if (b.parentNode) b.parentNode.removeChild(b); }, 600);
      }, 8000);
    }

    // Wait until app.js has loaded courses + modal exists
    function tryOpen() {
      var modal = document.getElementById('enrollModalBackdrop');
      if (!modal || typeof window.openEnrollModal !== 'function') {
        setTimeout(tryOpen, 400);
        return;
      }
      showBanner();
      window.openEnrollModal({
        courseId: pending.courseId,
        name: pending.name || 'Course',
        examPrice: pending.examPrice || 0,
        pathPrice: pending.pathPrice || pending.examPrice || 0,
        icon: pending.icon || 'fa-certificate'
      });
      // Clean URL so refresh doesn't re-trigger
      try {
        var clean = window.location.pathname;
        window.history.replaceState({}, '', clean);
      } catch (e) {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { setTimeout(tryOpen, 800); });
    } else {
      setTimeout(tryOpen, 800);
    }
  } catch (e) { console.warn('[Retry handler] error', e); }
})();

