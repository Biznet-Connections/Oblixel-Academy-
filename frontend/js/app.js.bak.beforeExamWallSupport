  function debug(msg) {
    debugEl.style.display = 'block';
    debugEl.textContent += '[' + new Date().toLocaleTimeString() + '] ' + msg + '\n';
    debugEl.scrollTop = debugEl.scrollHeight;
    console.log('[LegalNameDebug]', msg);
  }

  // Load full user data in background
  (async () => {
    try {
      debug('Loading user data from server...');
      const r = await apiRequest('/admin/users/' + user.id + '/full');
      if (r && r.user) {
        currentUserData = r.user;
        debug('Loaded: ' + JSON.stringify(r.user, null, 2));
        // Update inputs with fresh data
        const fn = document.getElementById('adminLegalFirstName');
        const ln = document.getElementById('adminLegalLastName');
        if (fn && !fn.value) fn.value = r.user.firstName || '';
        if (ln && !ln.value) ln.value = r.user.lastName || '';
      } else {
        debug('No user data returned');
      }
    } catch (e) {
      debug('Load error: ' + e.message);
    }
  })();

  // Save handler with verbose debug
  document.getElementById('adminLegalSaveBtn').addEventListener('click', async () => {
    const firstName = document.getElementById('adminLegalFirstName').value.trim();
    const lastName = document.getElementById('adminLegalLastName').value.trim();
    const reason = document.getElementById('adminLegalReason').value.trim();

    debug('--- SAVE CLICKED ---');
    debug('firstName=' + JSON.stringify(firstName));
    debug('lastName=' + JSON.stringify(lastName));
    debug('userId=' + user.id);
    debug('reason=' + JSON.stringify(reason));

    if (!firstName || !lastName) {
      debug('✗ ABORT: names required');
      showToast('Both first and last name required', 'error');
      return;
    }

    const saveBtn = document.getElementById('adminLegalSaveBtn');
    saveBtn.disabled = true;
    saveBtn.innerHTML = 'Saving...';

    try {
      const apiUrl = (window.API_BASE_URL || '/api') + '/admin/users/' + user.id + '/override-legal-name';
      debug('POST → ' + apiUrl);

      const token = localStorage.getItem('auth_token');
      debug('Token present: ' + !!token);

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify({ firstName, lastName, reason })
      });

      debug('HTTP ' + response.status + ' ' + response.statusText);

      const text = await response.text();
      debug('Response body: ' + text);

      let data;
      try { data = JSON.parse(text); } catch (e) { data = { raw: text }; }

      if (!response.ok) {
        debug('✗ FAILED: ' + (data.error || response.statusText));
        showToast('Failed (' + response.status + '): ' + (data.error || 'Unknown error'), 'error');
        saveBtn.disabled = false;
        saveBtn.innerHTML = 'Save';
        return;
      }

      debug('✓ SUCCESS: ' + JSON.stringify(data));
      showToast('Legal name updated: ' + (data.newName || firstName + ' ' + lastName), 'success');

      // Close modal
      document.getElementById('adminEditLegalNameModal').remove();

      // Force full admin refresh
      setTimeout(() => {
        if (typeof renderAdmin === 'function') renderAdmin();
      }, 400);

    } catch (e) {
      debug('✗ EXCEPTION: ' + e.message);
      showToast('Network error: ' + e.message, 'error');
      saveBtn.disabled = false;
      saveBtn.innerHTML = 'Save';
    }
  });

  // Clear legal name handler
  document.getElementById('adminClearLegalBtn').addEventListener('click', async () => {
    if (!confirm('Clear legal name for ' + (currentUserData.name || currentUserData.email) + '?\n\nUser will be able to set it again.')) return;
    try {
      debug('DELETE legal name...');
      await apiRequest('/admin/users/' + user.id + '/legal-name', { method: 'DELETE', body: JSON.stringify({}) });
      debug('✓ Cleared');
      showToast('Legal name cleared', 'success');
      document.getElementById('adminEditLegalNameModal').remove();
      setTimeout(() => { if (typeof renderAdmin === 'function') renderAdmin(); }, 400);
    } catch (e) {
      debug('✗ Clear failed: ' + e.message);
      showToast('Failed: ' + e.message, 'error');
    }
  });
}

