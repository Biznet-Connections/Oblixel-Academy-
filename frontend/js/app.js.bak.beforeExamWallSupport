function collectAdminCertPositions() {
  function v(id, fb) { const el = document.getElementById(id); return el ? parseInt(el.value) : fb; }
  function vf(id, fb) { const el = document.getElementById(id); return el ? parseFloat(el.value) : fb; }
  return {
    nameX: v('posNameX', 800), nameY: v('posNameY', 455),
    courseX: v('posCourseX', 800), courseY: v('posCourseY', 620),
    dateX: v('posDateX', 470), dateY: v('posDateY', 885),
    expiryDateX: v('posExpiryDateX', 470), expiryDateY: v('posExpiryDateY', 920),
    certIdX: v('posCertIdX', 1180), certIdY: v('posCertIdY', 885),
    verifyUrlX: v('posVerifyUrlX', 1180), verifyUrlY: v('posVerifyUrlY', 920),
    signatureX: v('posSignatureX', 800), signatureY: v('posSignatureY', 980),
    signatureScale: vf('posSignatureScale', 1.0)
  };
}

function collectAdminCertStyles() {
  function val(id, fb) { const el = document.getElementById(id); return el ? el.value : fb; }
  return {
    fontFamily: val('fontFamily', 'Georgia'),
    nameFontSize: parseInt(val('fontNameSize', 52)),
    nameFontColor: val('fontNameColorText', '#1a1a1a'),
    courseFontSize: parseInt(val('fontCourseSize', 36)),
    courseFontColor: val('fontCourseColorText', '#1a1a1a'),
    dateFontSize: parseInt(val('fontDateSize', 28)),
    dateFontColor: val('fontDateColorText', '#1a1a1a'),
    expiryDateFontSize: parseInt(val('fontExpiryDateSize', 24)),
    expiryDateFontColor: val('fontExpiryDateColorText', '#1a1a1a'),
    certIdFontSize: parseInt(val('fontCertIdSize', 28)),
    certIdFontColor: val('fontCertIdColorText', '#1a1a1a'),
    verifyUrlFontSize: parseInt(val('fontVerifyUrlSize', 20)),
    verifyUrlFontColor: val('fontVerifyUrlColorText', '#1a1a1a')
  };
}

async function saveAdminCertSettings() {
  try {
    const imageUrl = document.getElementById('certTemplateImage')?.value || '';
    const positions = collectAdminCertPositions();
    const styles = collectAdminCertStyles();
    const sig = window._certTemplate?.signatureImage || '';
    const expP = document.getElementById('expiryPeriod')?.value || 'never';
    const vBase = document.getElementById('verifyUrlBase')?.value || '';

    if (typeof updateCertificateTemplateImage === 'function') await updateCertificateTemplateImage(imageUrl);
    if (typeof updateCertificateTemplateSettings === 'function') await updateCertificateTemplateSettings(positions, styles, sig, expP, vBase, customTextFields);

    if (window._certTemplate) {
      window._certTemplate.expiryPeriod = expP;
      window._certTemplate.verifyUrlBase = vBase;
    }
    showToast('Certificate settings saved!', 'success');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}

