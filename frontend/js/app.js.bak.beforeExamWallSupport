function initDragAndDrop() {
  // v16 — drag-and-drop for admin course table (reorder on landing page)
  var rows = document.querySelectorAll('#adminCourseTableBody .course-drag-row');
  if (rows.length === 0) {
    console.log('[DragDrop] No course rows found');
    return;
  }
  console.log('[DragDrop] Wiring', rows.length, 'rows for drag');

  var draggedRow = null;

  rows.forEach(function(row) {
    row.setAttribute('draggable', 'true');

    row.addEventListener('dragstart', function(e) {
      draggedRow = this;
      this.classList.add('course-row-dragging');
      this.style.opacity = '0.4';
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', this.dataset.courseId || '');
    });

    row.addEventListener('dragend', function() {
      this.classList.remove('course-row-dragging');
      this.style.opacity = '';
      document.querySelectorAll('.course-drag-row').forEach(function(r) {
        r.classList.remove('course-row-drag-over');
        r.style.borderTop = '';
        r.style.borderBottom = '';
      });
      draggedRow = null;
    });

    row.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      if (this === draggedRow) return;
      // Visual drop indicator
      var rect = this.getBoundingClientRect();
      var midY = rect.top + rect.height / 2;
      if (e.clientY < midY) {
        this.style.borderTop = '2px solid #8b5cf6';
        this.style.borderBottom = '';
      } else {
        this.style.borderBottom = '2px solid #8b5cf6';
        this.style.borderTop = '';
      }
    });

    row.addEventListener('dragleave', function() {
      this.style.borderTop = '';
      this.style.borderBottom = '';
    });

    row.addEventListener('drop', function(e) {
      e.preventDefault();
      this.style.borderTop = '';
      this.style.borderBottom = '';
      if (this === draggedRow || !draggedRow) return;

      var tbody = document.getElementById('adminCourseTableBody');
      if (!tbody) return;

      var rect = this.getBoundingClientRect();
      var midY = rect.top + rect.height / 2;
      var dropBefore = e.clientY < midY;

      if (dropBefore) {
        tbody.insertBefore(draggedRow, this);
      } else {
        tbody.insertBefore(draggedRow, this.nextSibling);
      }

      // Auto-save order after a short delay
      if (typeof saveAdminCourseOrder === 'function') {
        setTimeout(saveAdminCourseOrder, 300);
      }
    });
  });

  // Touch support (mobile)
  rows.forEach(function(row) {
