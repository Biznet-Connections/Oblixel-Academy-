    h += '<button class="admin-menu-item danger" data-action="delete-user"><i class="fa-solid fa-trash"></i>Delete user</button>';
  }
  h += '</div>';

  document.body.insertAdjacentHTML('beforeend', h);
  const menu = document.querySelector('.admin-menu-popover:last-child');
