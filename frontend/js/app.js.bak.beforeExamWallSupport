        <div id="loginError" class="auth-error hidden"><i class="fa-solid fa-circle-exclamation"></i><span id="loginErrorText"></span></div>

        <div class="auth-field">
          <label class="auth-label">Email</label>
          <div class="auth-input-wrap">
            <input id="loginEmail" type="email" class="auth-input" placeholder="you@example.com" autocomplete="email" autocapitalize="off" spellcheck="false">
