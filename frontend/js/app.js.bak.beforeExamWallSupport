  setTimeout(() => {
    const el = document.getElementById('regName');
    if (el) el.focus();
  }, 100);

  // Password direction fix
  const regPass = document.getElementById('regPass');
  regPass.setAttribute('dir', 'ltr');
  regPass.style.direction = 'ltr';
  regPass.style.unicodeBidi = 'normal';

  // Toggle password visibility
  let vis = false;
  document.getElementById('toggleRegPass').addEventListener('click', () => {
    vis = !vis;
    regPass.type = vis ? 'text' : 'password';
    document.getElementById('toggleRegPass').innerHTML = vis
      ? '<i class="fa-regular fa-eye-slash"></i>'
      : '<i class="fa-regular fa-eye"></i>';
  });

  // Enter key submit
  ['regName', 'regEmail', 'regPass'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); doRegisterClick(); }
    });
  });

  function showRegError(msg) {
    const box = document.getElementById('regError');
    const txt = document.getElementById('regErrorText');
    if (!box || !txt) return;
    txt.textContent = msg;
    box.classList.remove('hidden');
    const card = document.querySelector('.auth-card');
    if (card) {
      card.classList.remove('auth-shake');
      void card.offsetWidth;
      card.classList.add('auth-shake');
    }
  }

  function hideRegError() {
    const box = document.getElementById('regError');
    if (box) box.classList.add('hidden');
  }

  ['regName', 'regEmail', 'regPass'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', hideRegError);
  });

  async function doRegisterClick() {
    const name = document.getElementById('regName').value.trim();
    const email = document.getElementById('regEmail').value.trim().toLowerCase();
    const password = regPass.value;

    hideRegError();

    if (!name || !email || !password) {
      showRegError('Please fill in all fields.');
      return;
    }
    if (name.length < 2) {
      showRegError('Please enter your full name.');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showRegError('Please enter a valid email address.');
      return;
    }
    if (password.length < 5) {
      showRegError('Password must be at least 5 characters.');
      return;
    }

    const btn = document.getElementById('doRegister');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<div class="spinner"></div> Creating account...';

    try {
      // 1. Register
      await register(name, email, password);

      // 2. Auto-login with the same credentials
      try {
        const data = await login(email, password, false);
        currentUser = data.user;

        // Load admin privileges if admin
        if (currentUser.role === 'admin') {
          try {
            const privData = await getMyAdminPrivileges();
            myAdminPrivileges = privData;
            currentUser.isMainAdmin = privData.isMainAdmin;
            currentUser.adminPrivileges = privData.privileges;
          } catch (e) { myAdminPrivileges = null; }
        }

        try {
          const enrollmentData = await getMyEnrollments();
          userEnrollmentsCache = enrollmentData.enrollments || [];
        } catch (e) { userEnrollmentsCache = []; }

        showToast(`Welcome to obliXel, ${name.split(' ')[0]}! 🎉`, 'success');
        updateAuthUI();
        updateNavbarStyle();
        await loadCourses();

        // 3. Auto-route to dashboard
        renderPage('dashboard');
        return;
      } catch (loginErr) {
        // Login after register failed — fall back to login page
        console.warn('Auto-login after register failed:', loginErr);
        showToast('Account created! Please sign in.', 'success');
        renderPage('login');
        return;
      }
    } catch (error) {
      const msg = (error && error.message) ? error.message : 'Registration failed. Please try again.';
      showRegError(msg);
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  }

  document.getElementById('doRegister').addEventListener('click', doRegisterClick);
  document.getElementById('switchToLogin').addEventListener('click', (e) => {
    e.preventDefault(); renderPage('login');
  });

  applyAllPasswordFixes();
}
