  if (!voucher) return;
  const used = voucher.usedCount || 0;

  let h = '<div class="admin-menu-popover" style="top:' + Math.min(rect.bottom + 4, window.innerHeight - 220) + 'px;left:' + Math.min(rect.right - 240, window.innerWidth - 250) + 'px;">';
