    h += '<div class="admin-menu-divider"></div>';
    if (isMain) h += '<button class="admin-menu-item" data-action="edit-privileges"><i class="fa-solid fa-gear"></i>Edit privileges</button>';
    if (isMain) h += '<button class="admin-menu-item danger" data-action="remove-admin"><i class="fa-solid fa-user-slash"></i>Remove admin</button>';
  }
  if (user.email !== currentUser.email && !user.isMainAdmin) {
