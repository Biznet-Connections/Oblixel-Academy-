      '</div>' +
    '</div>';
    return;
  }

  // FALLBACK
  if (response.message) {
    if (typeof showToast === 'function') showToast(response.message, 'warning');
  } else {
    if (typeof showToast === 'function') showToast('Could not start exam', 'error');
  }
};


