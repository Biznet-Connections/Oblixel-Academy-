}

.u-hero-stat.streak i { color: #f97316; }
.u-hero-stat.level i  { color: #a78bfa; }
.u-hero-stat.xp i     { color: #38bdf8; }

/* ---------- Next Step panel (adaptive CTA) ---------- */
.u-nextstep {
  background: linear-gradient(135deg, rgba(139,92,246,0.12), rgba(139,92,246,0.04));
  border: 1px solid rgba(139,92,246,0.35);
  border-radius: 12px;
  padding: 20px 22px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.u-nextstep-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: rgba(139,92,246,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--u-accent-hi);
  font-size: 20px;
  flex-shrink: 0;
}

.u-nextstep-body {
  flex: 1;
  min-width: 200px;
}

.u-nextstep-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--u-accent-hi);
  margin-bottom: 4px;
}

.u-nextstep-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--u-text);
  margin-bottom: 2px;
}

.u-nextstep-desc {
  font-size: 13px;
  color: var(--u-meta);
}

.u-nextstep-action {
  flex-shrink: 0;
}

/* ---------- Primary button ---------- */
.u-btn {
  height: 40px;
  padding: 0 18px;
  border-radius: 10px;
  background: var(--u-accent);
  border: none;
  color: #fff;
  font-weight: 600;
  font-size: 13.5px;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.15s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
}

.u-btn:hover {
  background: var(--u-accent-hi);
  transform: translateY(-1px);
}

.u-btn:active { transform: translateY(0); }

.u-btn-ghost {
  background: var(--u-elevated);
  border: 1px solid var(--u-border);
  color: var(--u-text);
}

.u-btn-ghost:hover {
  background: var(--u-hover);
  border-color: var(--u-border-hi);
  transform: translateY(-1px);
}

.u-btn-lg {
  height: 46px;
  padding: 0 24px;
  font-size: 14.5px;
  border-radius: 12px;
}

/* ---------- Grid helper ---------- */
.u-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 20px;
}

/* ---------- Panel ---------- */
.u-panel {
  background: var(--u-panel);
  border: 1px solid var(--u-border);
  border-radius: 12px;
  padding: 18px 20px;
}

.u-panel-title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--u-muted);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  justify-content: space-between;
}

.u-panel-title-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.u-panel-title i { color: var(--u-accent); }

.u-panel-link {
  font-size: 12px;
  font-weight: 600;
  color: var(--u-accent-hi);
  text-decoration: none;
  cursor: pointer;
  text-transform: none;
  letter-spacing: 0;
}

.u-panel-link:hover { color: var(--u-text); }

/* ---------- Continue Learning card ---------- */
.u-course-active {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  background: var(--u-elevated);
  border-radius: 10px;
  margin-bottom: 10px;
  transition: all 0.15s;
  border: 1px solid transparent;
}

.u-course-active:hover {
  border-color: var(--u-accent);
}

.u-course-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: rgba(139,92,246,0.15);
  color: var(--u-accent-hi);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}

.u-course-body {
  flex: 1;
  min-width: 0;
}

.u-course-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--u-text);
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.u-course-meta {
  font-size: 12px;
  color: var(--u-muted);
}

.u-progress-bar {
  height: 5px;
  background: rgba(255,255,255,0.08);
  border-radius: 3px;
  overflow: hidden;
  margin-top: 6px;
}

.u-progress-fill {
  height: 100%;
  background: var(--u-accent);
  border-radius: 3px;
  transition: width 0.4s;
}

/* ---------- Quick actions ---------- */
.u-quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.u-quick-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: var(--u-elevated);
  border-radius: 10px;
  color: var(--u-text);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
  text-decoration: none;
  border: 1px solid transparent;
}

.u-quick-item:hover {
  background: var(--u-hover);
  border-color: var(--u-border-hi);
}

.u-quick-item i {
  width: 20px;
  text-align: center;
  color: var(--u-accent-hi);
  font-size: 14px;
}

/* ---------- Recommended courses (horizontal scroll) ---------- */
.u-scroll-row {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 8px;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
}

.u-scroll-row::-webkit-scrollbar { height: 6px; }
.u-scroll-row::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.1);
  border-radius: 3px;
}

.u-course-card {
  background: var(--u-panel);
  border: 1px solid var(--u-border);
  border-radius: 12px;
  padding: 16px;
  min-width: 220px;
  max-width: 220px;
  scroll-snap-align: start;
  cursor: pointer;
  transition: all 0.15s;
  display: flex;
  flex-direction: column;
}

.u-course-card:hover {
  border-color: var(--u-accent);
  transform: translateY(-2px);
}

.u-course-card-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: rgba(139,92,246,0.15);
  color: var(--u-accent-hi);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-bottom: 10px;
}

.u-course-card-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--u-text);
  margin-bottom: 4px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 36px;
}

.u-course-card-cat {
  font-size: 11px;
  color: var(--u-muted);
  text-transform: uppercase;
  letter-spacing: 0.4px;
  font-weight: 600;
  margin-bottom: 10px;
}

.u-course-card-price {
  font-size: 18px;
  font-weight: 700;
  color: var(--u-text);
  margin-top: auto;
  padding-top: 8px;
}

/* ---------- Achievements ---------- */
.u-achievements {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 10px;
}

.u-achievement {
  padding: 14px 10px;
  background: var(--u-elevated);
  border-radius: 10px;
  text-align: center;
  border: 1px solid transparent;
  transition: all 0.15s;
}

.u-achievement.unlocked {
  border-color: rgba(139,92,246,0.4);
  background: rgba(139,92,246,0.08);
}

.u-achievement.locked {
  opacity: 0.5;
}

.u-achievement-icon {
  font-size: 22px;
  margin-bottom: 6px;
  display: block;
}

.u-achievement-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--u-meta);
  line-height: 1.3;
}

.u-achievement.unlocked .u-achievement-label {
  color: var(--u-text);
}

/* ---------- Empty state ---------- */
.u-empty {
  padding: 32px 20px;
  text-align: center;
  color: var(--u-muted);
  font-size: 13.5px;
}

.u-empty i {
  font-size: 32px;
  color: var(--u-border-hi);
  display: block;
  margin-bottom: 10px;
}

/* ---------- Filter pills ---------- */
.u-filter-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 16px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.u-pill {
  height: 32px;
  padding: 0 14px;
  border-radius: 999px;
  background: transparent;
  border: 1px solid var(--u-border);
  color: var(--u-meta);
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
  font-family: inherit;
  white-space: nowrap;
  transition: all 0.12s;
}

.u-pill:hover { border-color: var(--u-border-hi); color: var(--u-text); }

.u-pill.active {
  background: rgba(139,92,246,0.15);
  border-color: rgba(139,92,246,0.5);
  color: var(--u-accent-hi);
}

/* ---------- Stat pill (right side of hero) ---------- */
.u-stat-group {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.u-stat-pill {
  padding: 6px 12px;
  background: var(--u-elevated);
  border: 1px solid var(--u-border);
  border-radius: 999px;
  font-size: 12.5px;
  color: var(--u-text);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 500;
}

.u-stat-pill i { font-size: 11px; }

/* ---------- Mobile bottom tabs ---------- */
.user-mobile-tabs {
  display: none;
}

/* ---------- Hide old hamburger-driven mobile menu on small screens ---------- */
@media (max-width: 900px) {
  #mobileMenu { display: none !important; }
  #mobileMenuBtn { display: none !important; }

  .user-shell {
    grid-template-columns: 1fr;
    margin: -1rem -1rem 80px -1rem;
  }

  .user-sidebar { display: none; }

  .user-content { padding: 16px; }

  .u-grid-2 { grid-template-columns: 1fr; }

  .u-nextstep {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .u-nextstep-action { width: 100%; }

  .u-nextstep-action .u-btn { width: 100%; justify-content: center; }

  .u-quick-grid { grid-template-columns: 1fr 1fr; }

  /* Bottom tab bar */
  .user-mobile-tabs {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 62px;
    background: var(--u-panel);
    border-top: 1px solid var(--u-border);
    z-index: 60;
    justify-content: space-around;
    align-items: center;
    padding: 0 4px;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .user-mobile-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 8px 6px;
    border-radius: 8px;
    color: var(--u-muted);
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    background: transparent;
    font-family: inherit;
    min-width: 52px;
    transition: all 0.12s;
  }

  .user-mobile-tab i {
    font-size: 17px;
    margin-bottom: 1px;
  }

  .user-mobile-tab.active {
    color: var(--u-accent-hi);
  }

  .user-mobile-tab.active i {
    transform: translateY(-1px);
  }
}

@media (max-width: 480px) {
  .u-quick-grid { grid-template-columns: 1fr; }
  .u-course-card { min-width: 180px; max-width: 180px; }
}
