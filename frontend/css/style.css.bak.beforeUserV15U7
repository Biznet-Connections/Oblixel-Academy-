/* ==================== ADMIN CONSOLE REDESIGN (v14) ==================== */
/* Pro layout: sidebar + topbar + tabs. Purple accent, muted palette, info-dense. */

:root {
  --a-bg:        #0a0a0f;
  --a-panel:     #131320;
  --a-elevated:  #1c1c2e;
  --a-hover:     #252540;
  --a-border:    #26263a;
  --a-border-hi: #35354d;
  --a-text:      #f5f5f7;
  --a-meta:      #a1a1aa;
  --a-muted:     #71717a;
  --a-accent:    #8b5cf6;
  --a-accent-hi: #a78bfa;
  --a-success:   #10b981;
  --a-warning:   #f59e0b;
  --a-danger:    #ef4444;
}

/* ---------- Layout shell ---------- */
.admin-shell {
  display: grid;
  grid-template-columns: 240px 1fr;
  min-height: calc(100vh - 76px);
  background: var(--a-bg);
  margin: -1rem -1rem 0 -1rem;
  border-top: 1px solid var(--a-border);
}

.admin-sidebar {
  background: var(--a-panel);
  border-right: 1px solid var(--a-border);
  padding: 20px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  position: sticky;
  top: 76px;
  height: calc(100vh - 76px);
  overflow-y: auto;
}

.admin-sidebar-brand {
  padding: 8px 12px 20px;
  border-bottom: 1px solid var(--a-border);
  margin-bottom: 12px;
}

.admin-sidebar-brand-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--a-text);
  letter-spacing: 0.2px;
}

.admin-sidebar-brand-sub {
  font-size: 11px;
  color: var(--a-muted);
  margin-top: 2px;
}

.admin-nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border-radius: 8px;
  color: var(--a-meta);
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.12s;
  border-left: 2px solid transparent;
  text-decoration: none;
  user-select: none;
}

.admin-nav-item:hover {
  background: var(--a-elevated);
  color: var(--a-text);
}

.admin-nav-item.active {
  background: var(--a-elevated);
  color: var(--a-text);
  border-left-color: var(--a-accent);
}

.admin-nav-item i {
  width: 18px;
  text-align: center;
  font-size: 14px;
  opacity: 0.9;
}

.admin-nav-item.active i {
  color: var(--a-accent);
}

.admin-nav-section {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--a-muted);
  padding: 16px 12px 6px;
}

/* ---------- Top bar ---------- */
.admin-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  height: 52px;
  padding: 0 20px;
  background: var(--a-panel);
  border-bottom: 1px solid var(--a-border);
}

.admin-topbar-crumb {
  font-size: 13px;
  color: var(--a-meta);
  display: flex;
  align-items: center;
  gap: 8px;
}

.admin-topbar-crumb strong {
  color: var(--a-text);
  font-weight: 600;
}

.admin-topbar-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.admin-icon-btn {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: transparent;
  border: 1px solid transparent;
  color: var(--a-meta);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.12s;
  font-size: 14px;
}

.admin-icon-btn:hover {
  background: var(--a-elevated);
  color: var(--a-text);
  border-color: var(--a-border);
}

/* ---------- Content area ---------- */
.admin-content {
  padding: 24px;
  overflow-x: hidden;
  min-width: 0;
}

.admin-tab { display: none; }
.admin-tab.active { display: block; animation: adminFadeIn 0.2s ease; }

@keyframes adminFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------- KPI cards ---------- */
.admin-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}

.admin-kpi {
  background: var(--a-panel);
  border: 1px solid var(--a-border);
  border-radius: 12px;
  padding: 16px 18px;
}

.admin-kpi-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--a-muted);
  margin-bottom: 8px;
}

.admin-kpi-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--a-text);
  letter-spacing: -0.5px;
  line-height: 1;
}

.admin-kpi-delta {
  font-size: 12px;
  margin-top: 6px;
  color: var(--a-muted);
  display: flex;
  align-items: center;
  gap: 4px;
}

.admin-kpi-delta.up   { color: var(--a-success); }
.admin-kpi-delta.down { color: var(--a-danger); }

/* ---------- Panel (generic container) ---------- */
.admin-panel {
  background: var(--a-panel);
  border: 1px solid var(--a-border);
  border-radius: 12px;
  padding: 18px 20px;
  margin-bottom: 16px;
}

.admin-panel-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--a-text);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.admin-panel-title i { color: var(--a-accent); }

.admin-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.admin-chart-wrap {
  position: relative;
  height: 220px;
}

/* ---------- Table ---------- */
.admin-table-pro {
  width: 100%;
  border-collapse: collapse;
  font-size: 13.5px;
}

.admin-table-pro thead th {
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--a-muted);
  padding: 10px 12px;
  border-bottom: 1px solid var(--a-border);
  background: transparent;
}

.admin-table-pro tbody tr {
  border-bottom: 1px solid var(--a-border);
  transition: background 0.1s;
}

.admin-table-pro tbody tr:hover {
  background: var(--a-elevated);
}

.admin-table-pro tbody td {
  padding: 12px;
  color: var(--a-meta);
  vertical-align: middle;
}

.admin-table-pro tbody td strong { color: var(--a-text); font-weight: 600; }

.admin-avatar-sm {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--a-accent), #6d28d9);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: 12px;
  flex-shrink: 0;
}

/* ---------- Pills / badges ---------- */
.admin-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.2px;
}

.admin-pill.admin { background: rgba(139,92,246,0.15); color: var(--a-accent-hi); }
.admin-pill.main  { background: rgba(245,158,11,0.15); color: #fcd34d; }
.admin-pill.student { background: rgba(161,161,170,0.12); color: var(--a-meta); }
.admin-pill.ok    { background: rgba(16,185,129,0.15); color: #34d399; }
.admin-pill.warn  { background: rgba(245,158,11,0.15); color: #fbbf24; }

/* ---------- Search + filter row ---------- */
.admin-toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}

.admin-search {
  flex: 1;
  min-width: 200px;
  height: 36px;
  background: var(--a-elevated);
  border: 1px solid var(--a-border);
  border-radius: 8px;
  color: var(--a-text);
  padding: 0 12px 0 34px;
  font-size: 13px;
  font-family: inherit;
  position: relative;
  transition: border-color 0.15s;
}

.admin-search:focus {
  outline: none;
  border-color: var(--a-accent);
}

.admin-search-wrap {
  position: relative;
  flex: 1;
  min-width: 200px;
}

.admin-search-wrap i {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--a-muted);
  font-size: 12px;
  pointer-events: none;
}

.admin-pill-btn {
  height: 32px;
  padding: 0 12px;
  border-radius: 8px;
  background: transparent;
  border: 1px solid var(--a-border);
  color: var(--a-meta);
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.12s;
}

.admin-pill-btn:hover { border-color: var(--a-border-hi); color: var(--a-text); }
.admin-pill-btn.active {
  background: rgba(139,92,246,0.15);
  border-color: rgba(139,92,246,0.5);
  color: var(--a-accent-hi);
}

/* ---------- Buttons ---------- */
.admin-btn {
  height: 36px;
  padding: 0 14px;
  border-radius: 8px;
  background: var(--a-accent);
  border: none;
  color: #fff;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.12s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.admin-btn:hover { background: var(--a-accent-hi); }

.admin-btn-ghost {
  background: transparent;
  border: 1px solid var(--a-border);
  color: var(--a-text);
}

.admin-btn-ghost:hover {
  background: var(--a-elevated);
  border-color: var(--a-border-hi);
}

.admin-btn-danger {
  background: transparent;
  border: 1px solid rgba(239,68,68,0.4);
  color: var(--a-danger);
}

.admin-btn-danger:hover {
  background: rgba(239,68,68,0.15);
  border-color: var(--a-danger);
}

/* ---------- Row actions menu ("···") ---------- */
.admin-row-menu-btn {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: transparent;
  border: none;
  color: var(--a-meta);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.admin-row-menu-btn:hover {
  background: var(--a-elevated);
  color: var(--a-text);
}

.admin-menu-popover {
  position: fixed;
  z-index: 5000;
  background: var(--a-elevated);
  border: 1px solid var(--a-border-hi);
  border-radius: 10px;
  padding: 6px;
  width: 240px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.5);
  animation: adminMenuIn 0.12s ease;
}

@keyframes adminMenuIn {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}

.admin-menu-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 6px;
  color: var(--a-text);
  font-size: 13px;
  cursor: pointer;
  transition: background 0.1s;
  border: none;
  background: transparent;
  width: 100%;
  text-align: left;
  font-family: inherit;
}

.admin-menu-item:hover { background: var(--a-hover); }

.admin-menu-item.danger { color: var(--a-danger); }
.admin-menu-item.danger:hover { background: rgba(239,68,68,0.1); }

.admin-menu-item i {
  width: 16px;
  text-align: center;
  font-size: 13px;
  opacity: 0.85;
}

.admin-menu-divider {
  height: 1px;
  background: var(--a-border);
  margin: 4px 6px;
}

/* ---------- Mobile bottom nav ---------- */
.admin-mobile-nav {
  display: none;
}

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .admin-shell {
    grid-template-columns: 1fr;
    margin: -1rem -1rem 80px -1rem;
  }

  .admin-sidebar {
    display: none;
  }

  .admin-content {
    padding: 16px;
  }

  .admin-kpi-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .admin-kpi-value { font-size: 22px; }

  .admin-grid-2 {
    grid-template-columns: 1fr;
  }

  /* Table → cards on mobile */
  .admin-table-pro thead { display: none; }

  .admin-table-pro tbody tr {
    display: block;
    background: var(--a-panel);
    border: 1px solid var(--a-border);
    border-radius: 10px;
    margin-bottom: 10px;
    padding: 12px;
  }

  .admin-table-pro tbody td {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border: none;
    color: var(--a-meta);
  }

  .admin-table-pro tbody td::before {
    content: attr(data-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--a-muted);
  }

  /* Show mobile bottom nav */
  .admin-mobile-nav {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: var(--a-panel);
    border-top: 1px solid var(--a-border);
    z-index: 40;
    justify-content: space-around;
    align-items: center;
    padding: 0 6px;
  }

  .admin-mobile-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--a-muted);
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    background: transparent;
    font-family: inherit;
    min-width: 48px;
    transition: all 0.12s;
  }

  .admin-mobile-nav-item i {
    font-size: 16px;
  }

  .admin-mobile-nav-item.active {
    color: var(--a-accent-hi);
  }
}

@media (max-width: 480px) {
  .admin-kpi-grid { grid-template-columns: 1fr 1fr; }
  .admin-kpi { padding: 12px 14px; }
  .admin-kpi-value { font-size: 20px; }
  .admin-kpi-label { font-size: 10px; }
}

